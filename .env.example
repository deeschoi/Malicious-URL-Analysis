# Copy to .env (gitignored) and fill in. Real environment variables always win,
# so a container's own settings are never overridden by this file.

# --- Analyst chat (optional) ------------------------------------------------
# Without a key the /api/chat endpoint returns 503 and the UI hides the panel.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT=45
# GROQ_MAX_TOOL_STEPS=5

# --- API protection ---------------------------------------------------------
# Leave SPHINX_API_KEY unset for a localhost demo. Set it before binding this
# service to anything reachable: with no key, anyone who can reach the port can
# force outbound fetches from your network and read every stored scan.
# Clients send it as the X-API-Key header (the UI reads VITE_SPHINX_API_KEY at
# build time).
SPHINX_API_KEY=
# SPHINX_SCAN_RATE_PER_MINUTE=20
# SPHINX_SCAN_MAX_CONCURRENT=4
# Only enable behind a proxy you control — a client can otherwise forge
# X-Forwarded-For and get a fresh rate-limit budget on every request.
# SPHINX_TRUST_PROXY_HEADERS=0

# --- Storage ----------------------------------------------------------------
# PHISHING_DATABASE_URL=postgresql+psycopg2://phishing:CHANGE_ME@db:5432/phishing
