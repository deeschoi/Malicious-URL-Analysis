# Copy to .env (gitignored) and fill in. Real environment variables always win,
# so a container's own settings are never overridden by this file.

# --- Analyst chat (optional) ------------------------------------------------
# Chat is BYOK: the UI pastes a Groq key and sends it as X-Groq-Api-Key.
# GROQ_API_KEY is a local fallback only. A public demo should omit it so Groq
# bills the visitor, not the operator. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT=45
# GROQ_MAX_TOOL_STEPS=5
# SPHINX_CHAT_RATE_PER_MINUTE=30
# SPHINX_CHAT_MAX_CONCURRENT=1

# --- API protection ---------------------------------------------------------
# Leave SPHINX_API_KEY unset for a localhost or public demo. Set it before
# binding this service to anything reachable if you want a shared gate: with
# no key, anyone who can reach the port can force outbound fetches and read
# scan history. Rate limits still apply. Clients send it as X-API-Key (the UI
# reads VITE_SPHINX_API_KEY at build time).
SPHINX_API_KEY=
# SPHINX_SCAN_RATE_PER_MINUTE=20
# SPHINX_SCAN_MAX_CONCURRENT=4
# Only enable behind a proxy you control — a client can otherwise forge
# X-Forwarded-For and get a fresh rate-limit budget on every request.
# SPHINX_TRUST_PROXY_HEADERS=0

# --- Storage ----------------------------------------------------------------
# PHISHING_DATABASE_URL=postgresql+psycopg2://phishing:CHANGE_ME@db:5432/phishing
